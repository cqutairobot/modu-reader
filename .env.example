# 必填：替换成自己的长随机密码；没有默认登录密码。
READER_PASSWORD=
# Docker 在宿主机上的回环端口；已有项目占用 8000 时可换成空闲端口。
READER_BIND_PORT=8000
# 多项目服务器建议设置独立且固定的项目名，例如 modu_reader。
# COMPOSE_PROJECT_NAME=modu_reader
# 本地 HTTP 调试设 false；云服务器通过 HTTPS 访问必须设 true。
READER_COOKIE_SECURE=true
# 使用你自己的域名，精确到协议和端口；多个地址以英文逗号分隔。
READER_TRUSTED_ORIGINS=https://reader.example.com
READER_MAX_UPLOAD_BYTES=5242880
# 以下两项供本地启动使用，Docker Compose 会覆盖为容器内的固定路径。
READER_DATA_DIR=./data
READER_STATIC_DIR=./frontend/dist
